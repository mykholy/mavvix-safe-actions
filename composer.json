{
    "name": "mykholy/mavvix-safe-actions",
    "description": "A fail-closed selection safety foundation for consequential Filament bulk actions.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "filament", "bulk-actions", "authorization", "safety"],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/database": "^11.28|^12.0|^13.0",
        "illuminate/support": "^11.28|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {"Mavvix\\SafeActions\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Mavvix\\SafeActions\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Mavvix\\SafeActions\\SafeActionsServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "format:check": "pint --test"
    },
    "config": {"sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
