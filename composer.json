{
    "name": "mykholy/mavvix-safe-actions",
    "description": "Fail-closed, tenant-aware Filament 5 bulk actions with verified selections, expiring preflights and transactional execution.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "filament-plugin",
        "bulk-actions",
        "eloquent",
        "authorization",
        "multi-tenancy",
        "transaction",
        "preflight",
        "data-safety"
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Mavvix\\SafeActions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mavvix\\SafeActions\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mavvix\\SafeActions\\SafeActionsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "format:check": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/mykholy/mavvix-safe-actions",
    "authors": [
        {
            "name": "Ahmed Elkholy",
            "homepage": "https://github.com/mykholy",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/mykholy/mavvix-safe-actions/issues",
        "source": "https://github.com/mykholy/mavvix-safe-actions",
        "security": "https://github.com/mykholy/mavvix-safe-actions/security/policy"
    }
}
